# OSS 配置
OSS_ACCESS_KEY=your_access_key_here
OSS_SECRET_KEY=your_secret_key_here
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 自定义或传输加速端点需指定存储桶地域，例如 cn-hangzhou
# OSS_REGION=cn-hangzhou
OSS_BUCKET=your_bucket_name
OSS_OBJECT_PREFIX=

# 备份目录路径（支持多个目录，用逗号分隔）
# 例如: DIRS_TO_BACKUP=/etc/nginx,/var/log,/home/user/data
DIRS_TO_BACKUP=/path/to/backup

# 排除模式（支持多个模式，用逗号分隔，支持 glob 模式）
# 例如: EXCLUDE_PATTERNS=*.log,node_modules,.git,tmp
EXCLUDE_PATTERNS=

# 备份压缩方式，可选 zstd、gzip、none
COMPRESS_METHOD=zstd

# 设置非空密码可加密备份。请为实际配置文件设置 0600 权限
BACKUP_PASSWORD=
